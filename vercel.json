{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/zh",
      "destination": "/index.html"
    },
    {
      "source": "/zh/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index-en.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/index-en.html"
    },
    {
      "source": "/cn",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}